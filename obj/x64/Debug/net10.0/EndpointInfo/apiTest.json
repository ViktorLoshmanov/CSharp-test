    "/map": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Получение преобразованных геоданных (тест без реального ответа)",
        "description": "Выбирает геоданные по области, отсекает приметивы по оласти, оптимизирует координаты, преобразовывает к экранным",
        "parameters": [
          {
            "name": "x",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "y",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    },
    "/mapJSON": {
      "get": {
        "tags": [
          "Map"
        ],
        "summary": "Получение преобразованных геоданных",
        "description": "Выбирает геоданные по области, отсекает приметивы по оласти, оптимизирует координаты, преобразовывает к экранным",
        "parameters": [
          {
            "name": "x",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0
            }
          },
          {
            "name": "y",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ILayer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/naturalsort": {
      "get": {
        "tags": [
