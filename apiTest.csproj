<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>

    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <Configurations>Debug;Release;linux-x64</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!--<PackageReference Include="LinkDotNet.StringBuilder" Version="3.4.2" />-->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!--<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />-->
    <!--<PackageReference Include="mimalloc-csharp" Version="1.0.7" />-->
    <PackageReference Include="Ryu.NET" Version="20.7.18" />
    <!--<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />-->
    <PackageReference Include="Utf8Json" Version="1.3.7" />

    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="1024" Trim="false" /> 

  </ItemGroup>

</Project>
